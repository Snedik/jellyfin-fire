<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp TV launcher banner: app logo centered on the launcher icon background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:bottom="56dp"
        android:drawable="@drawable/app_logo"
        android:left="34dp"
        android:right="34dp"
        android:top="56dp" />
</layer-list>
