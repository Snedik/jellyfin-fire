-const { deviceId, deviceName, appName, appVersion } = JSON.parse(window.NativeInterface.getDeviceInformation());
+const { deviceId, deviceName, appName, appVersion, isTv } = JSON.parse(window.NativeInterface.getDeviceInformation());
 const codecCaps = JSON.parse(window.NativeInterface.getCodecCapabilities());
 
+// TV specific adjustments: render at a larger viewport width (scaled down to fit
+// the screen by the WebView) and load style tweaks for the TV layout
+const TV_VIEWPORT_WIDTH = 1480;
+if (isTv) {
+    const viewport = document.querySelector('meta[name=viewport]');
+    if (viewport) {
+        viewport.content = `width=${TV_VIEWPORT_WIDTH}, user-scalable=no, viewport-fit=cover`;
+    }
+
+    // TV devices often report the pixel ratio of a 4K panel while the UI is only rendered in 1080p,
+    // which makes the web client request far larger images than can be displayed. Report the actual
+    // ratio between the 1080p surface and the viewport instead, with some headroom for sharpness.
+    const tvPixelRatio = Math.min(window.devicePixelRatio, (1920 / TV_VIEWPORT_WIDTH) * 1.25);
+    Object.defineProperty(window, 'devicePixelRatio', { get: () => tvPixelRatio });
+
+    // Let SyncPlay continuously correct the playback position by default, as the playback of other
+    // group members (e.g. HLS streams starting at keyframes) often differs by a few seconds
+    try {
+        if (localStorage.getItem('syncPlay-enableSyncCorrection') === null) {
+            localStorage.setItem('syncPlay-enableSyncCorrection', 'true');
+        }
+        // Changing the playback speed has no effect with audio passthrough (e.g. Dolby Digital to the TV),
+        // so correct differences by skipping instead
+        if (localStorage.getItem('syncPlay-useSpeedToSync') === null) {
+            localStorage.setItem('syncPlay-useSpeedToSync', 'false');
+        }
+    } catch (e) {
+        console.warn('Failed to apply SyncPlay defaults', e);
+    }
+
+    // When the focus got lost (nothing or only the root is focused), arrow keys would have nowhere
+    // to navigate from. Focus the first visible element of the open dialog or the current page instead.
+    document.addEventListener('keydown', (event) => {
+        if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Enter'].includes(event.key)) return;
+        const active = document.activeElement;
+        if (active && active !== document.body && active.id !== 'reactRoot' && active.offsetParent !== null) return;
+
+        const container = document.querySelector('.dialogContainer .dialog')
+            || document.querySelector('.page:not(.hide)')
+            || document.body;
+        const target = Array.from(container.querySelectorAll('input, select, textarea, button, a[href], [tabindex]:not([tabindex="-1"])'))
+            .find((element) => !element.disabled && element.offsetParent !== null);
+        if (target) {
+            target.focus();
+            event.preventDefault();
+            event.stopPropagation();
+        }
+    }, true);
+
+    const tvStyle = document.createElement('link');
+    tvStyle.rel = 'stylesheet';
+    tvStyle.href = '/native/tv.css';
+    document.head.appendChild(tvStyle);
+}
