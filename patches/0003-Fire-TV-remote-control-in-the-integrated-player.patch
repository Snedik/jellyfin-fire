+    /**
+     * Key code of the last key press handled by [handleKeyEvent], its release has to be consumed as well.
+     */
+    private var handledKeyCode: Int? = null
+
+    private val hideSeekOverlayAction = Runnable {
+        _playerBinding?.seekOverlayLayout?.isVisible = false
+    }
+
+    /**
+     * Handles remote control keys while the player controls are hidden, as known from TV apps:
+     * OK toggles playback, left/right seek and up/down reveal the controls.
+     * Any other key event is left to the [PlayerView].
+     *
+     * @return true if the event was consumed
+     */
+    fun handleKeyEvent(event: KeyEvent): Boolean {
+        if (event.action == KeyEvent.ACTION_UP && event.keyCode == handledKeyCode) {
+            handledKeyCode = null
+            return true
+        }
+        if (event.action != KeyEvent.ACTION_DOWN || _playerBinding == null || playerView.isControllerFullyVisible) {
+            return false
+        }
+
+        when (event.keyCode) {
+            KeyEvent.KEYCODE_DPAD_CENTER, KeyEvent.KEYCODE_ENTER -> {
+                if (viewModel.playerOrNull == null) return false
+                viewModel.userPlayPause()
+                playerView.showController()
+            }
+            KeyEvent.KEYCODE_DPAD_LEFT -> {
+                viewModel.userRewind()
+                showSeekOverlay(forward = false)
+            }
+            KeyEvent.KEYCODE_DPAD_RIGHT -> {
+                viewModel.userFastForward()
+                showSeekOverlay(forward = true)
+            }
+            KeyEvent.KEYCODE_DPAD_UP, KeyEvent.KEYCODE_DPAD_DOWN -> playerView.showController()
+            else -> return false
+        }
+        handledKeyCode = event.keyCode
+        return true
+    }
+
+    private fun showSeekOverlay(forward: Boolean) {
+        val player = viewModel.playerOrNull ?: return
+        val position = player.currentPosition
+        val duration = player.duration.coerceAtLeast(0)
+        with(playerBinding) {
+            seekOverlayImage.setImageResource(
+                if (forward) R.drawable.ic_fast_forward_black_32dp else R.drawable.ic_rewind_black_32dp,
+            )
+            seekOverlayText.text = Util.getStringForTime(StringBuilder(), java.util.Formatter(), position)
+            seekPositionText.text = Util.getStringForTime(StringBuilder(), java.util.Formatter(), duration)
+            if (duration > 0) {
+                seekOverlayProgress.max = 1000
+                seekOverlayProgress.progress = (position * 1000 / duration).toInt()
+            }
+            seekOverlayLayout.isVisible = true
+            seekOverlayLayout.removeCallbacks(hideSeekOverlayAction)
+            seekOverlayLayout.postDelayed(hideSeekOverlayAction, Constants.DEFAULT_SEEK_OVERLAY_TIMEOUT_MS)
+        }
+    }
+
     /**
