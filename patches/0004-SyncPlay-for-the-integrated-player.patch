     async changeSubtitleStream(index) {}
 
     getPlaylist() {
-        return Promise.resolve([]);
+        return Promise.resolve(this.getPlaylistSync());
     }
 
-    getCurrentPlaylistItemId() {}
+    getPlaylistSync() {
+        return this._currentItem ? [this._currentItem] : [];
+    }
 
-    setCurrentPlaylistItem() {
-        return Promise.resolve();
+    currentItem() {
+        return this._currentItem;
+    }
+
+    /**
+     * Whether any media is loaded, used by the playback manager.
+     */
+    isPlaying() {
+        return this._currentItem != null;
+    }
+
+    currentMediaSource() {
+        return this._getMediaSource();
+    }
+
+    getCurrentPlaylistItemId() {
+        return this._currentItem?.PlaylistItemId;
+    }
+
+    getCurrentPlaylistIndex() {
+        return 0;
+    }
+
+    /**
+     * Changes the playing item, used by SyncPlay when the group moves to another item of its queue.
+     * @param {string} playlistItemId The playlist id of the item to play.
+     */
+    async setCurrentPlaylistItem(playlistItemId) {
+        const playbackManager = this.playbackManager;
+        if (!playbackManager.syncPlayEnabled || !playbackManager._localPlay) return;
+
+        // The SyncPlay queue contains the items of the group's queue
+        const playlist = playbackManager._playQueueManager?.getPlaylist?.() || [];
+        const startIndex = playlist.findIndex((item) => item.PlaylistItemId === playlistItemId);
+        if (startIndex < 0) return;
+
+        await playbackManager._localPlay({
+            items: playlist,
+            startIndex: startIndex,
+            startPositionTicks: 0,
+            fullscreen: true,
+        });
     }
 
     removeFromPlaylist() {
