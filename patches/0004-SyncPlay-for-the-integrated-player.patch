+            return this._currentTime + (Date.now() - this._positionUpdatedAt) * this._playbackRate;
+        }
         return this._currentTime;
     }
 
+    getPlaybackRate() {
+        return this._playbackRate;
+    }
+
+    setPlaybackRate(value) {
+        this._playbackRate = value;
+        this._nativePlayer.setPlaybackSpeed(value);
+    }
+
     duration(val) {
         return null;
     }
