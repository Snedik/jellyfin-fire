@@ -20,21 +20,254 @@ export class ExoPlayerPlugin {
         this._paused = true;
 
         this._nativePlayer = window['NativePlayer'];
+
+        // SyncPlay controls this player like the HTML video player, based on the events reported by notifyEvent()
+        this.syncPlayWrapAs = 'htmlvideoplayer';
+        this._syncPlay = false;
+        this._seeking = false;
+        this._playbackRate = 1;
+        this._positionUpdatedAt = 0;
+        this._onLoaded = null;
+        this._playToken = 0;
+        this._currentItem = null;
+        this._buffering = false;
+        this._groupWaiting = false;
+        this._groupUpdatesBound = false;
+
+        this._patchSetCurrentPlaylistItem();
+        this._patchCreateSyncPlayGroup();
+    }
+
+    /**
+     * The server takes the queue of a new group from the queue the creating session reported last, which it
+     * only updates when playback stops. After the native player moved on to another item, that queue doesn't
+     * contain the playing item anymore and the group ends up without one. Hand the playlist over instead.
+     * It has to include the following items: for a queue of a single episode, the web client adds the
+     * remaining episodes of the series locally and then fails to match its playlist with the group's.
+     */
+    _patchCreateSyncPlayGroup() {
+        const apiClient = window.ApiClient;
+        if (!apiClient) {
+            setTimeout(() => this._patchCreateSyncPlayGroup(), 1000);
+            return;
+        }
+        const proto = Object.getPrototypeOf(apiClient);
+        const originalCreateGroup = proto.createSyncPlayGroup;
+        if (!originalCreateGroup || originalCreateGroup._nativePatched) return;
+
+        const plugin = this;
+        proto.createSyncPlayGroup = function (options) {
+            if (!plugin._currentItem) {
+                return originalCreateGroup.call(this, options);
+            }
+            // Outside of SyncPlay, only the native player knows the playing item and position, which it reports
+            const nowPlaying = plugin._getReportedPlayback(this);
+            return originalCreateGroup.call(this, options).then(async (result) => {
+                const playback = await nowPlaying;
+                if (playback) {
+                    let queue = plugin._playlistItemIds || [];
+                    let index = queue.indexOf(playback.itemId);
+                    if (index < 0) {
+                        queue = [playback.itemId];
+                        index = 0;
+                    }
+                    this.requestSyncPlaySetNewQueue({
+                        PlayingQueue: queue,
+                        PlayingItemPosition: index,
+                        StartPositionTicks: playback.positionTicks,
+                    });
+                }
+                return result;
+            });
+        };
+        proto.createSyncPlayGroup._nativePatched = true;
+    }
+
+    /**
+     * Gets the playing item and position the native player reported to the server for this device.
+     * The native player reports with its own session, whose device id starts with the one of the web client.
+     */
+    async _getReportedPlayback(apiClient) {
+        try {
+            const deviceId = apiClient.deviceId();
+            const sessions = await apiClient.getSessions();
+            const session = sessions.find((s) => s.DeviceId?.startsWith(deviceId) && s.NowPlayingItem?.Id);
+            if (!session) return null;
+            let positionTicks = session.PlayState?.PositionTicks || 0;
+            // Account for the time since the last report
+            if (!session.PlayState?.IsPaused && session.LastPlaybackCheckIn) {
+                const elapsedMs = Date.now() - new Date(session.LastPlaybackCheckIn).getTime();
+                if (elapsedMs > 0 && elapsedMs < 60000) positionTicks += elapsedMs * 10000;
+            }
+            return { itemId: session.NowPlayingItem.Id, positionTicks: Math.round(positionTicks) };
+        } catch (e) {
+            console.warn('ExoPlayer: failed to get the reported playback', e);
+            return null;
+        }
+    }
+
+    /**
+     * Without an active player (e.g. after the previous item ended), the playback manager can't hand the
+     * playlist over to this player when changing the item, which SyncPlay does when the group moves on.
+     * Start the item with the whole playlist instead. SyncPlay saves this method when it becomes active.
+     */
+    _patchSetCurrentPlaylistItem() {
+        const playbackManager = this.playbackManager;
+        const originalSetCurrentPlaylistItem = playbackManager.setCurrentPlaylistItem;
+        playbackManager.setCurrentPlaylistItem = (playlistItemId, player) => {
+            if (!player && !playbackManager.getCurrentPlayer() && this._nativePlayer.isEnabled()) {
+                const items = playbackManager._playQueueManager?.getPlaylist?.() || [];
+                const startIndex = items.findIndex((item) => item.PlaylistItemId === playlistItemId);
+                const play = playbackManager._localPlay || playbackManager.play;
+                if (startIndex >= 0) {
+                    return play.call(playbackManager, { items, startIndex, startPositionTicks: 0, fullscreen: true });
+                }
+            }
+            return originalSetCurrentPlaylistItem.call(playbackManager, playlistItemId, player);
+        };
     }
 
     async play(options) {
+        // Remember the started item and its playlist, as this player manages its own playlist
+        this._currentItem = options.items[options.startIndex || 0];
+        this._playlistItemIds = options.items.map(item => item.Id);
+
         // Sanitize input
         options.ids = options.items.map(item => item.Id);
         delete options.items;
 
+        this._syncPlay = this.playbackManager.syncPlayEnabled === true;
+        this._playToken++;
+        this._bindGroupUpdates();
         const preferences = {
             maxStreamingBitrateLocal: this.appSettings.maxStreamingBitrate(true, 'Video'),
             maxStreamingBitrateRemote: this.appSettings.maxStreamingBitrate(false, 'Video'),
+            syncPlay: this._syncPlay,
+            syncPlayToken: this._playToken,
         };
 
         this._paused = false;
+        this._seeking = false;
+        this._playbackRate = 1;
+        this._setPosition((options.startPositionTicks || 0) / 10000);
+
+        // SyncPlay starts to control the player once play() returns, so wait until it's actually loaded
+        const loaded = this._syncPlay ? new Promise((resolve) => {
+            this._onLoaded = resolve;
+            setTimeout(resolve, 30000);
+        }) : Promise.resolve();
+
         this._nativePlayer.loadPlayer(JSON.stringify(options), JSON.stringify(preferences));
         this.loading.hide();
+        await loaded;
+        this._onLoaded = null;
+    }
+
+    /**
+     * Called by the native player to report playback events while SyncPlay is active.
+     * Translates them to the events of the HTML video player, which SyncPlay listens to.
+     * @param {string} event The event name.
+     * @param {number} positionMs The current playback position in milliseconds.
+     * @param {number} token The token of the playback, events of replaced players are ignored.
+     * @param {number} sampledAt The time of the position measurement, in milliseconds since the epoch.
+     */
+    notifyEvent(event, positionMs, token, sampledAt) {
+        if (!this._syncPlay || token !== this._playToken) return;
+        this._setPosition(positionMs, sampledAt);
+
+        switch (event) {
+            case 'loaded':
+                if (this._onLoaded) this._onLoaded();
+                // The playback manager only considers this player active once it reports the started item
+                setTimeout(() => this.events.trigger(this, 'itemstarted', [this._currentItem, this._getMediaSource()]));
+                break;
+            case 'playing':
+                // Playback before a pending seek is completed doesn't count
+                if (this._seeking) break;
+                this._setBuffering(false);
+                if (this._paused) {
+                    this._paused = false;
+                    this.events.trigger(this, 'unpause');
+                }
+                this.events.trigger(this, 'playing');
+                break;
+            case 'pause':
+                if (!this._paused) {
+                    this._paused = true;
+                    this.events.trigger(this, 'pause');
+                }
+                break;
+            case 'waiting':
+                this._setBuffering(true);
+                this.events.trigger(this, 'waiting');
+                break;
+            case 'ready':
+                this._setBuffering(false);
+                // Buffering finished while paused: SyncPlay considers the player ready on its playing event
+                if (!this._seeking) this.events.trigger(this, 'playing');
+                break;
+            case 'seeked':
+                this._seeking = false;
+                this.events.trigger(this, 'timeupdate');
+                break;
+            case 'timeupdate':
+                this.events.trigger(this, 'timeupdate');
+                break;
+            case 'stopped':
+                this._syncPlay = false;
+                this._paused = true;
+                this._groupWaiting = false;
+                this._nativePlayer.setSyncPlayWaiting(false);
+                this.events.trigger(this, 'itemstopped', [{
+                    item: this._currentItem,
+                    mediaSource: this._getMediaSource(),
+                    positionMs: positionMs,
+                    nextItem: null,
+                    nextMediaType: null,
+                }]);
+                this._currentItem = null;
+                break;
+        }
+    }
+
+    /**
+     * Forwards SyncPlay group events to the native player, as the web client is hidden during playback.
+     */
+    _bindGroupUpdates() {
+        if (this._groupUpdatesBound || !window.ServerNotifications) return;
+        this._groupUpdatesBound = true;
+        this.events.on(window.ServerNotifications, 'SyncPlayGroupUpdate', (e, apiClient, update) => {
+            if (!this._syncPlay || !update) return;
+            switch (update.Type) {
+                case 'UserJoined':
+                case 'UserLeft':
+                    this._nativePlayer.notifySyncPlayUser(String(update.Data), update.Type === 'UserJoined');
+                    break;
+                case 'StateUpdate':
+                    this._groupWaiting = update.Data?.State === 'Waiting';
+                    this._updateWaitingHint();
+                    break;
+            }
+        });
+    }
+
+    _setBuffering(buffering) {
+        this._buffering = buffering;
+        this._updateWaitingHint();
+    }
+
+    _updateWaitingHint() {
+        // Only show the hint while this player is ready, i.e. it's waiting for others
+        this._nativePlayer.setSyncPlayWaiting(this._groupWaiting && !this._buffering);
+    }
+
+    _getMediaSource() {
+        return this._currentItem?.MediaSources?.[0] || null;
+    }
+
+    _setPosition(positionMs, sampledAt = Date.now()) {
+        this._currentTime = positionMs;
+        this._positionUpdatedAt = sampledAt;
     }
 
     shuffle(item) {}
