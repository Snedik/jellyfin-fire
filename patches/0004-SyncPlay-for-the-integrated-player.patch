+    // User initiated player controls, sent as requests to the group while SyncPlay is active.
+    // The group then sends the resulting command to all members, including this one.
+    fun userPlay() {
+        if (isSyncPlayActive) webappFunctionChannel.callPlaybackManagerAction("unpause") else play()
+    }
+
+    fun userPause() {
+        if (isSyncPlayActive) webappFunctionChannel.callPlaybackManagerAction("pause") else pause()
+    }
+
+    fun userPlayPause() {
+        if (playerOrNull?.playWhenReady == true) userPause() else userPlay()
+    }
+
+    fun userSeekTo(positionMs: Long) {
+        if (isSyncPlayActive) {
+            webappFunctionChannel.seekToTicks(positionMs.coerceAtLeast(0) * Constants.TICKS_PER_MILLISECOND)
+        } else {
+            playerOrNull?.seekTo(positionMs)
+        }
+    }
+
+    fun userSeekByOffset(offsetMs: Long) {
+        val player = playerOrNull ?: return
+        userSeekTo(player.currentPosition + offsetMs)
+    }
+
+    fun userRewind() {
+        if (isSyncPlayActive) userSeekByOffset(-displayPreferences.skipBackLength) else rewind()
+    }
+
+    fun userFastForward() {
+        if (isSyncPlayActive) userSeekByOffset(displayPreferences.skipForwardLength) else fastForward()
+    }
+
+    fun userSkipToPrevious() {
+        if (isSyncPlayActive) webappFunctionChannel.callPlaybackManagerAction("previousTrack") else skipToPrevious()
+    }
+
+    fun userSkipToNext() {
+        if (isSyncPlayActive) webappFunctionChannel.callPlaybackManagerAction("nextTrack") else skipToNext()
+    }
+
+    /**
+     * Reports a player event to the ExoPlayer plugin of the web client, which relays it to SyncPlay.
+     */
+    private fun notifySyncPlay(event: String) {
+        if (!isSyncPlayActive) return
+        val position = playerOrNull?.currentPosition ?: return
+        // The time of the measurement allows the web client to compensate the delay of this call
+        val sampledAt = System.currentTimeMillis()
+        webappFunctionChannel.call("window.ExoPlayer?.notifyEvent('$event', $position, $syncPlayToken, $sampledAt);")
+    }
+
+    private fun startSyncPlayTimeUpdates() {
+        if (!isSyncPlayActive || syncPlayTimeUpdateJob?.isActive == true) return
+        syncPlayTimeUpdateJob = viewModelScope.launch {
+            while (true) {
+                delay(Constants.SYNCPLAY_TIME_UPDATE_RATE)
+                notifySyncPlay(SYNCPLAY_EVENT_TIME_UPDATE)
+            }
+        }
+    }
+
+    private fun stopSyncPlayTimeUpdates() {
+        syncPlayTimeUpdateJob?.cancel()
+        syncPlayTimeUpdateJob = null
